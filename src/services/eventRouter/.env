PORT=8085
HOST=0.0.0.0
KAFKA_BOOTSTRAP_SERVERS=192.168.49.2:31315
# Kafka topic allowlist
KAFKA_TOPICS=input.raw.extracted,audio.raw.extracted,text.synthesis.input,audio.synthesis.input,text.synthesis.output,text.group.synthesis.input,text.group.synthesis.output,audio.generated,dead-letter,pipeline-output,task-status

# Consumer defaults (applied if a consumer doesn't override)
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true
KAFKA_POLL_TIMEOUT_MS=1000

# Prefixes for consistent IDs
KAFKA_CLIENT_ID_PREFIX=koldavarConsumer
KAFKA_GROUP_ID_PREFIX=koldavar

# =========================
# Consumers are created ONLY in eventRouter
# eventRouter will create ONE consumer per entry below
# map: microServiceName -> topics it should consume
# =========================

# Comma-separated service names to instantiate consumers for
KAFKA_CONSUMER_SERVICES=inputExtraction,audioToText,textSynthesizer,syncManager

# Per-service topic subscriptions (CSV)

ROUTER_BASEURL_INPUT_EXTRACTION=http://input-extraction-service:8081
ROUTER_BASEURL_AUDIO_TO_TEXT=http://audio-to-text-service:8080
ROUTER_BASEURL_SYNC_MANAGER=http://sync-manager-service:8082
ROUTER_BASEURL_TEXT_SYNTHESIZER=http://text-synthesizer-service:8083
# ROUTER_BASEURL_TTS=http://tts-service:8084   # only if enabled