# ============================================
# KOLDAVAR - Text to Audio Service Environment
# ============================================

# --- Flask Configuration ---
FLASK_ENV=development
FLASK_APP=server.py
HOST=0.0.0.0
PORT=5000
DEBUG=True

# --- Logging ---
LOG_LEVEL=INFO

# --- TTS Engine ---
# F5-TTS base model (local inference, zero-shot voice cloning)
TTS_ENGINE=f5
TTS_MODEL=F5-TTS-base
USE_GPU=False

# --- Audio Output Settings ---
AUDIO_OUTPUT_DIR=generated
AUDIO_FORMAT=mp3

# --- (Optional) Hugging Face token for model download ---
# Used only if first model pull requires authentication (rare)
HF_API_TOKEN=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
# custom Hugging Face model cache
HF_HOME=./models/huggingface
HF_HUB_CACHE=./models/huggingface/hub
TORCH_HOME=./models/huggingface/torch
