# ==========================================================
# Flask / Server Configuration
# ==========================================================
HOST=0.0.0.0
PORT=5000
DEBUG=True

# ==========================================================
# TTS / Voice Cloning Engine
# ==========================================================
# Supported values: f5-tts | coqui | huggingface-bark
TTS_ENGINE=f5-tts
TTS_MODEL=SWivid/F5-TTS
F5_VERBOSE=1
CPU_OPTIMIZED=1
# ==========================================================
# Hugging Face Access
# ==========================================================
# Personal Access Token (optional for public models)
HF_TOKEN=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

# Local model cache directories
HF_HOME=models/huggingface
HF_HUB_CACHE=models/huggingface/hub
TORCH_HOME=models/huggingface/torch

# Path to F5-TTS repo clone and vocoder
F5_REPO_PATH=models/github/SWivid__F5-TTS
VOCODER_PATH=models/huggingface/charactr-vocos-mel-24khz

# Offline mode (set to "1" if everything is cached locally)
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=1

# ==========================================================
# Logging
# ==========================================================
LOG_DIR=./logs
LOG_LEVEL=INFO

# ==========================================================
# Generated / Temporary Files
# ==========================================================
GENERATED_DIR=generated
